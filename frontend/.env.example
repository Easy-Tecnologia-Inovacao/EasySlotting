# Build de staging/produção: sirva /api pelo proxy do mesmo site.
VITE_API_URL=/api
# npm run dev sempre usa /api via Vite -> http://127.0.0.1:3000.
# VITE_API_URL é ignorada no desenvolvimento para preservar os cookies em LAN.
# Sites distintos exigem revisar cookies, CORS e CSRF antes de alterar a URL.
# VITE_* values are included in the public browser bundle. Never put secrets here.
